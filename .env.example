# Development builds only. Production always disables the mock advertisement.
EXPO_PUBLIC_ENABLE_MOCK_AD=false

# Optional public configuration. Leave blank for fully local play.
# NEVER put service-role/admin/secret keys here or anywhere in EXPO_PUBLIC_*.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dev-only numeric replay panel; never included in production UI.
# Development gameplay never submits records to production rankings.
EXPO_PUBLIC_REPLAY_DIAGNOSTICS=false

# Hosted verification target metadata only. Separate ignored files are required:
# .env.ranking.staging / .env.ranking.production (never real secret keys).
# RANKING_OTHER_PROJECT_REF is the opposite environment and must differ.
RANKING_ENVIRONMENT=
RANKING_PROJECT_REF=
RANKING_OTHER_PROJECT_REF=

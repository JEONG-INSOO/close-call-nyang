# Keep the credential/build exclusions from .gitignore.
node_modules/
.expo/
dist/
coverage/
test-results/
playwright-report/
blob-report/
output/
*.tsbuildinfo
npm-debug.log*
/debug.log
.env
.env.*
!.env.example
*.p8
*.p12
*.mobileprovision
credentials.json
supabase/.temp/
supabase/.branches/
.supabase/
.codeburn/
.codex/
.DS_Store
Thumbs.db

# Private working notes and non-app tooling are not build inputs.
.git
/.agents/
/.memory/
/docs/
/.github/
/examples/
/test
/CODEBURN-SETUP.md
/supabase/

# Release upload contains app runtime only, not local workflow or QA material.
/AGENTS.md
/README.md
/e2e/
/scripts/
/store/
/web-static/
/jest.config.cjs
/jest.setup.ts
/playwright.config.ts
**/__tests__/

# Only the packed diligent texture is used at runtime; keep frame sources in Git.
/assets/characters/diligent/step-*.png
/assets/characters/diligent/alarm-v3.png
/assets/characters/diligent/fall-v3.png
